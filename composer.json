{
    "name": "bektasozcetin/laravel-iletisim-sizinti-filtresi",
    "description": "Serbest metinde telefon, e-posta ve sosyal medya hesabı sızıntısını yakalar ve maskeler. Pazar yeri, randevu ve ilan platformları için.",
    "keywords": ["laravel", "validation", "marketplace", "moderation", "pii", "contact", "leak", "masking"],
    "homepage": "https://github.com/bektasozcetin/laravel-iletisim-sizinti-filtresi",
    "license": "MIT",
    "authors": [
        {
            "name": "Bektaş Özçetin",
            "homepage": "https://github.com/bektasozcetin"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Bektasozcetin\\IletisimFiltresi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bektasozcetin\\IletisimFiltresi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bektasozcetin\\IletisimFiltresi\\IletisimFiltresiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
